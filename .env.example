# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Dashboard > Project Settings > Database) —
# only needed locally to apply/verify supabase/migrations/*.sql.
DATABASE_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test-mode keys from the Stripe Dashboard; leave unset to fall
# back to manual/offline payment collection — see lib/payments/index.ts)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# locally, or the webhook endpoint's signing secret in the Dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Analytics (Module 21)
# First-party event collection. "supabase" (default) writes to
# analytics_events; "mock" logs events instead of persisting them.
ANALYTICS_PROVIDER=

# Third-party advertising pixels. ALL OPTIONAL and unset by default — with
# no ID configured the corresponding script never loads at all. They also
# only ever load for a visitor who granted MARKETING consent. Leave blank
# during development (free-first, Master Build Plan §3).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# AI (Module 22)
# OPTIONAL. Leave blank and everything still works: the deterministic
# engine (admin-curated FAQ matching, rules-based recommendations,
# template drafting) is the default and costs nothing. Set a key to
# upgrade FAQ answering and admin drafting to Claude — see docs/AI.md for
# what it can and cannot do, and for the cost note.
# The admin assistant (/admin/assistant, Module 42) is the one feature
# with NO free fallback: without a key it says so and refuses, because an
# assistant that cannot call the model has nothing to fall back to.
ANTHROPIC_API_KEY=
# Force the free path even when a key is set — useful for testing the
# fallback and for keeping spend at zero.
AI_PROVIDER=

# Email (Module 24)
# OPTIONAL. Leave blank and every email is logged by the mock provider
# instead of being sent — the whole app works with no email account.
# BOTH must be set to send real mail: Resend rejects a send from an
# unverified domain, and a half-configured provider that fails on every
# message is worse than an honest mock.
RESEND_API_KEY=
# The verified sender, e.g. "Luxury Lehenga <orders@yourdomain.com>"
EMAIL_FROM=
# Force the mock even when a key is set (useful for testing).
EMAIL_PROVIDER=

# Vercel Cron's own Authorization: Bearer header for /api/cron/* routes
# (https://vercel.com/docs/cron-jobs) — set automatically by Vercel when
# a cron is configured (vercel.json).
#
# MODULE 29 CHANGED THE BEHAVIOUR WHEN THIS IS MISSING. It used to mean
# "skip the check", which quietly turned every cron route into a public
# endpoint — and those routes email customers, delete analytics rows and
# reap carts. Now the routes FAIL CLOSED in production: 503, refusing to
# run at all.
#
# So this is REQUIRED, not optional. Without it the crons are safe but
# never run. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Set it locally too — the reminder, abandoned-cart and analytics tests
# authenticate with it, and without it they exercise the refusal path
# instead of the real one.
CRON_SECRET=

# ---------------------------------------------------------------------
# MCP / AI application control layer (Module 36)
# ---------------------------------------------------------------------
# Signs the confirmation tokens that gate high-risk MCP actions — the
# token is an HMAC over the tool name, its arguments and the acting
# admin, so confirming means confirming THAT action rather than saying
# "yes" in the abstract.
#
# OPTIONAL. With this unset the layer falls back to
# SUPABASE_SERVICE_ROLE_KEY, following the precedent in
# lib/security/rate-limit.ts. Set it in production anyway, so rotating
# the database key does not silently invalidate every pending
# confirmation.
#
# FAILS CLOSED: with neither value available, high-risk tools refuse to
# run rather than executing unconfirmed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_CONFIRMATION_SECRET=

# --- The stdio MCP adapter (Module 43) ------------------------------------
# Only for scripts/mcp-stdio.mjs, which connects an external MCP client
# (a desktop app) to this server. Not read by the application itself.
#
# MCP_ACCESS_TOKEN is a real Supabase access token for the staff account
# the client should act as — there is no MCP API key and no service
# account, by decision (12B.3). It EXPIRES, usually within the hour, and
# the adapter does not refresh it. Get one with:
#   node --env-file=.env.local scripts/mcp-stdio.mjs --token you@example.com
MCP_URL=
MCP_ACCESS_TOKEN=

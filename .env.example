# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Dashboard > Project Settings > Database) —
# only needed locally to apply/verify supabase/migrations/*.sql.
DATABASE_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test-mode keys from the Stripe Dashboard; leave unset to fall
# back to manual/offline payment collection — see lib/payments/index.ts)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# locally, or the webhook endpoint's signing secret in the Dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Analytics (Module 21)
# First-party event collection. "supabase" (default) writes to
# analytics_events; "mock" logs events instead of persisting them.
ANALYTICS_PROVIDER=

# Third-party advertising pixels. ALL OPTIONAL and unset by default — with
# no ID configured the corresponding script never loads at all. They also
# only ever load for a visitor who granted MARKETING consent. Leave blank
# during development (free-first, Master Build Plan §3).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# AI (Module 22)
# OPTIONAL. Leave blank and everything still works: the deterministic
# engine (admin-curated FAQ matching, rules-based recommendations,
# template drafting) is the default and costs nothing. Set a key to
# upgrade FAQ answering and admin drafting to Claude — see docs/AI.md for
# what it can and cannot do, and for the cost note.
ANTHROPIC_API_KEY=
# Force the free path even when a key is set — useful for testing the
# fallback and for keeping spend at zero.
AI_PROVIDER=

# Email (Module 24)
# OPTIONAL. Leave blank and every email is logged by the mock provider
# instead of being sent — the whole app works with no email account.
# BOTH must be set to send real mail: Resend rejects a send from an
# unverified domain, and a half-configured provider that fails on every
# message is worse than an honest mock.
RESEND_API_KEY=
# The verified sender, e.g. "Luxury Lehenga <orders@yourdomain.com>"
EMAIL_FROM=
# Force the mock even when a key is set (useful for testing).
EMAIL_PROVIDER=

# Vercel Cron's own Authorization: Bearer header for /api/cron/* routes
# (https://vercel.com/docs/cron-jobs) — set automatically by Vercel when
# a cron is configured (vercel.json); set this locally too if you want to
# test a cron route with the same check enforced. MUST be set before any
# real deploy, or the endpoint accepts unauthenticated requests.
CRON_SECRET=
